<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Style TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="TextColor" Value="{StaticResource IdmTextPrimary}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="IdmHeaderLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="TextColor" Value="{StaticResource IdmGridHeaderText}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style x:Key="IdmToolbarButtonLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="TextColor" Value="{StaticResource IdmTextPrimary}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12,6" />
    </Style>

    <Style x:Key="IdmPrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource IdmPrimary}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="BorderColor" Value="{StaticResource IdmPrimaryDark}" />
    </Style>

    <Style x:Key="IdmSecondaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="#F1F5F9" />
        <Setter Property="TextColor" Value="{StaticResource IdmTextPrimary}" />
        <Setter Property="BorderColor" Value="#CBD5E1" />
    </Style>

</ResourceDictionary>
