<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:OmniFetch.App.ViewModels"
    x:Class="OmniFetch.App.Views.Dialogs.AddDownloadDialog"
    x:DataType="vm:AddDownloadViewModel"
    Title="Enter new address to download"
    BackgroundColor="#F1F5F9"
    WidthRequest="600"
    HeightRequest="360">

    <Grid RowDefinitions="*,Auto" Padding="24" RowSpacing="16">
        <VerticalStackLayout Grid.Row="0" Spacing="14">
            <Label Text="Enter new address to download" FontAttributes="Bold" FontSize="16" TextColor="{StaticResource IdmPrimaryDark}" />

            <!-- URL Input -->
            <VerticalStackLayout Spacing="4">
                <Label Text="Address (URL):" FontSize="12" TextColor="{StaticResource IdmTextSecondary}" />
                <Border Stroke="#CBD5E1" StrokeThickness="1" BackgroundColor="White" Padding="8,4">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="4" />
                    </Border.StrokeShape>
                    <Entry Text="{Binding Url, Mode=TwoWay}" Placeholder="https://example.com/file.zip" FontSize="13" />
                </Border>
            </VerticalStackLayout>

            <!-- Save To Folder -->
            <VerticalStackLayout Spacing="4">
                <Label Text="Save To Directory:" FontSize="12" TextColor="{StaticResource IdmTextSecondary}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Border Grid.Column="0" Stroke="#CBD5E1" StrokeThickness="1" BackgroundColor="White" Padding="8,4">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="4" />
                        </Border.StrokeShape>
                        <Entry Text="{Binding DestinationPath, Mode=TwoWay}" FontSize="13" />
                    </Border>
                    <Button Grid.Column="1" Text="..." Clicked="OnBrowseClicked" WidthRequest="44" Style="{StaticResource IdmSecondaryButton}" />
                </Grid>
            </VerticalStackLayout>

            <!-- File Name & Category -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <VerticalStackLayout Grid.Column="0" Spacing="4">
                    <Label Text="File Name:" FontSize="12" TextColor="{StaticResource IdmTextSecondary}" />
                    <Border Stroke="#CBD5E1" StrokeThickness="1" BackgroundColor="White" Padding="8,4">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="4" />
                        </Border.StrokeShape>
                        <Entry Text="{Binding FileName, Mode=TwoWay}" FontSize="13" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" Spacing="4">
                    <Label Text="Category:" FontSize="12" TextColor="{StaticResource IdmTextSecondary}" />
                    <Border Stroke="#CBD5E1" StrokeThickness="1" BackgroundColor="White" Padding="8,2">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="4" />
                        </Border.StrokeShape>
                        <Picker SelectedItem="{Binding Category, Mode=TwoWay}" FontSize="13">
                            <Picker.ItemsSource>
                                <x:Array Type="{x:Type x:String}">
                                    <x:String>All</x:String>
                                    <x:String>Compressed</x:String>
                                    <x:String>Documents</x:String>
                                    <x:String>Music</x:String>
                                    <x:String>Programs</x:String>
                                    <x:String>Video</x:String>
                                </x:Array>
                            </Picker.ItemsSource>
                        </Picker>
                    </Border>
                </VerticalStackLayout>
            </Grid>
        </VerticalStackLayout>

        <!-- Bottom Action Buttons -->
        <HorizontalStackLayout Grid.Row="1" Spacing="12" HorizontalOptions="End">
            <Button Text="OK" Command="{Binding OkCommand}" Style="{StaticResource IdmPrimaryButton}" WidthRequest="90" />
            <Button Text="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource IdmSecondaryButton}" WidthRequest="90" />
        </HorizontalStackLayout>
    </Grid>

</ContentPage>
