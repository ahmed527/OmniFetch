<?xml version="1.0" encoding="utf-8" ?>
<ContentView 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="OmniFetch.App.Views.Controls.ToolbarButton"
    x:Name="ThisButton">

    <Grid WidthRequest="72" Margin="2,0">
        <!-- Visual Presentation Layer -->
        <Border 
            x:Name="ButtonBorder"
            BackgroundColor="Transparent"
            Stroke="Transparent"
            StrokeThickness="1"
            Padding="6,4"
            InputTransparent="True">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="4" />
            </Border.StrokeShape>

            <VerticalStackLayout Spacing="2" HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True">
                <Image 
                    x:Name="BtnImage"
                    Source="{Binding IconSource, Source={x:Reference ThisButton}}" 
                    WidthRequest="28" 
                    HeightRequest="28" 
                    Aspect="AspectFit" 
                    HorizontalOptions="Center"
                    InputTransparent="True" />
                <Label 
                    x:Name="BtnLabel"
                    Text="{Binding Text, Source={x:Reference ThisButton}}" 
                    Style="{DynamicResource IdmToolbarButtonLabel}" 
                    HorizontalOptions="Center"
                    LineBreakMode="NoWrap"
                    InputTransparent="True" />
            </VerticalStackLayout>
        </Border>

        <!-- Native Click Layer (Covers 100% of toolbar button surface) -->
        <Button 
            x:Name="NativeButton"
            BackgroundColor="Transparent"
            BorderColor="Transparent"
            BorderWidth="0"
            CornerRadius="4"
            HorizontalOptions="Fill"
            VerticalOptions="Fill"
            Clicked="OnNativeButtonClicked">
            <Button.GestureRecognizers>
                <PointerGestureRecognizer 
                    PointerEntered="OnPointerEntered" 
                    PointerExited="OnPointerExited" />
            </Button.GestureRecognizers>
        </Button>
    </Grid>
</ContentView>
